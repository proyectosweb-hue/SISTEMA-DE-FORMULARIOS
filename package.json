{
  "name": "sistema-de-formularios",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma centralizada de formularios para las estaciones de Junquito Gas.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "node scripts/demo.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@supabase/storage-js": "^2.119.0",
