# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repositorio.
# En Vercel, define estas variables en Project Settings > Environment Variables
# (por separado para Production y Preview).

# --- Supabase (público: se incluye en el navegador) ---------------------------------
# URL del proyecto, p. ej. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (publishable / anon). Es pública por diseño; la seguridad la dan
# las políticas RLS y el bucket privado.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SECRETO: solo servidor, nunca con prefijo NEXT_PUBLIC_) ---------------
# Clave secreta / service_role. Permite escribir en la base de datos y firmar subidas.
SUPABASE_SECRET_KEY=

# --- Opcional -----------------------------------------------------------------------
# Habilita el formulario TÉCNICO de prueba (estación + fotos) para validar el flujo
# completo en desarrollo o en vistas previas. Déjalo vacío/ausente en producción.
ENABLE_TECHNICAL_FORM=
